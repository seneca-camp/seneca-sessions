// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Schedule {
  id       String  @id @default(cuid())
  isPublic Boolean @default(false)

  name     String // e.g. (Session) Saturday
  date     DateTime
  sessions Session[]
}

model Room {
  id       String @id @default(cuid())
  name     String @unique
  position Int    @unique
}

model Session {
  id    String @id @default(cuid())
  title String
  room  String // TODO: This should be a relation to the Room model
  slot  Int
  note  String

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId String

  likedBy LikedSession[]
}

model LikedSession {
  id        String  @id @default(cuid())
  userId    String
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String

  @@unique([userId, sessionId])
}
